<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <CliAssemblyPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../cli/bin/$(Configuration)/$(TargetFramework)/mn.dll'))</CliAssemblyPath>
    <TestEditorExecutableName>MemoriaNote.TestEditor</TestEditorExecutableName>
    <TestEditorExecutableName Condition="$([MSBuild]::IsOSPlatform('Windows'))">MemoriaNote.TestEditor.exe</TestEditorExecutableName>
    <TestEditorExecutablePath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../MemoriaNote.TestEditor/bin/$(Configuration)/$(TargetFramework)/$(TestEditorExecutableName)'))</TestEditorExecutablePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="7.0.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../cli/mn.csproj" />
    <ProjectReference Include="../../core/MemoriaNote.Core.csproj" />
    <ProjectReference Include="../MemoriaNote.TestEditor/MemoriaNote.TestEditor.csproj" ReferenceOutputAssembly="false" />
    <AssemblyMetadata Include="CliAssemblyPath" Value="$(CliAssemblyPath)" />
    <AssemblyMetadata Include="TestEditorExecutablePath" Value="$(TestEditorExecutablePath)" />
  </ItemGroup>
</Project>

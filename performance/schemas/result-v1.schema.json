{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cabo-2/MemoriaNote/performance/schemas/result-v1.schema.json",
  "title": "MemoriaNote performance result version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "run",
    "target",
    "environment",
    "scenarioResults",
    "failures"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "run": { "$ref": "#/$defs/run" },
    "target": { "$ref": "#/$defs/target" },
    "dataset": { "$ref": "#/$defs/dataset" },
    "environment": { "$ref": "#/$defs/environment" },
    "scenarioResults": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenarioResult" }
    },
    "failures": {
      "type": "array",
      "items": { "$ref": "#/$defs/failure" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "startedAtUtc",
        "runnerVersion",
        "runnerCommit",
        "status"
      ],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "startedAtUtc": { "type": "string", "format": "date-time" },
        "runnerVersion": { "type": "string", "minLength": 1 },
        "runnerCommit": { "type": "string", "minLength": 1 },
        "status": { "enum": ["valid", "invalid"] }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "productVersion",
        "sourceCommit",
        "rid",
        "configuration",
        "deploymentKind",
        "artifactInputKind",
        "executableSha256",
        "executableSizeBytes"
      ],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "productVersion": { "type": "string", "minLength": 1 },
        "sourceCommit": { "type": "string", "minLength": 1 },
        "rid": { "type": "string", "minLength": 1 },
        "configuration": { "type": "string", "minLength": 1 },
        "deploymentKind": { "enum": ["self-contained", "native-aot"] },
        "artifactInputKind": {
          "enum": ["publish-directory", "extracted-archive"]
        },
        "executableSha256": { "$ref": "#/$defs/sha256" },
        "executableSizeBytes": { "type": "integer", "minimum": 1 },
        "archiveSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasetId",
        "datasetVersion",
        "sourceRevision",
        "preparedSha256"
      ],
      "properties": {
        "datasetId": { "type": "string", "minLength": 1 },
        "datasetVersion": { "type": "string", "minLength": 1 },
        "sourceRevision": { "type": "string", "minLength": 1 },
        "preparedSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentLabel",
        "osDescription",
        "osArchitecture",
        "processArchitecture",
        "cpuModel",
        "logicalProcessorCount",
        "fileSystem"
      ],
      "properties": {
        "environmentLabel": { "type": "string", "minLength": 1 },
        "osDescription": { "type": "string", "minLength": 1 },
        "osArchitecture": { "type": "string", "minLength": 1 },
        "processArchitecture": { "type": "string", "minLength": 1 },
        "cpuModel": { "type": "string", "minLength": 1 },
        "logicalProcessorCount": { "type": "integer", "minimum": 1 },
        "installedMemoryBytes": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "fileSystem": { "type": "string", "minLength": 1 },
        "powerModeNote": { "type": "string", "minLength": 1 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["isValid", "issues"],
      "properties": {
        "isValid": { "type": "boolean" },
        "issues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "status",
        "standardOutputBytes",
        "standardErrorBytes",
        "validation"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 0 },
        "elapsedNanoseconds": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "exitCode": { "type": ["integer", "null"] },
        "status": {
          "enum": ["valid", "timeout", "cancelled", "start-failure", "invalid"]
        },
        "standardOutputBytes": { "type": "integer", "minimum": 0 },
        "standardErrorBytes": { "type": "integer", "minimum": 0 },
        "peakWorkingSetBytes": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "totalProcessorTimeNanoseconds": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "secondaryMetricUnavailableReason": {
          "type": "string",
          "minLength": 1
        },
        "validation": { "$ref": "#/$defs/validation" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleCount",
        "percentileMethod",
        "p50Nanoseconds",
        "p95Nanoseconds",
        "minNanoseconds",
        "maxNanoseconds",
        "arithmeticMeanNanoseconds"
      ],
      "properties": {
        "sampleCount": { "type": "integer", "minimum": 1 },
        "percentileMethod": { "const": "nearest-rank" },
        "p50Nanoseconds": { "type": "integer", "minimum": 0 },
        "p95Nanoseconds": { "type": "integer", "minimum": 0 },
        "minNanoseconds": { "type": "integer", "minimum": 0 },
        "maxNanoseconds": { "type": "integer", "minimum": 0 },
        "arithmeticMeanNanoseconds": { "type": "integer", "minimum": 0 }
      }
    },
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "scenarioVersion",
        "cacheMode",
        "warmupCount",
        "measurementCount",
        "timeoutMilliseconds",
        "status",
        "samples",
        "validation"
      ],
      "properties": {
        "scenarioId": { "type": "string", "minLength": 1 },
        "scenarioVersion": { "type": "string", "minLength": 1 },
        "cacheMode": { "type": "string", "minLength": 1 },
        "warmupCount": { "type": "integer", "minimum": 0 },
        "measurementCount": { "type": "integer", "minimum": 1 },
        "timeoutMilliseconds": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["valid", "invalid"] },
        "samples": {
          "type": "array",
          "items": { "$ref": "#/$defs/sample" }
        },
        "summary": { "$ref": "#/$defs/summary" },
        "validation": { "$ref": "#/$defs/validation" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "scenarioId", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "scenarioId": { "type": "string" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}

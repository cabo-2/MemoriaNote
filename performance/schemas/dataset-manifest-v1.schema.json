{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cabo-2/MemoriaNote/performance/schemas/dataset-manifest-v1.schema.json",
  "title": "MemoriaNote performance dataset manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "datasetVersion",
    "languages",
    "source",
    "licenses",
    "selection",
    "transform",
    "prepared"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "datasetId": { "$ref": "#/$defs/identifier" },
    "datasetVersion": { "$ref": "#/$defs/identifier" },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "source": { "$ref": "#/$defs/source" },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/license" }
    },
    "selection": { "$ref": "#/$defs/selection" },
    "transform": { "$ref": "#/$defs/transform" },
    "prepared": { "$ref": "#/$defs/prepared" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "revision"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "archiveSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "appliesTo", "licenseFile", "attribution"],
      "properties": {
        "expression": { "type": "string", "minLength": 1 },
        "appliesTo": { "type": "string", "minLength": 1 },
        "licenseFile": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scaleId", "pageCount"],
      "properties": {
        "scaleId": { "$ref": "#/$defs/identifier" },
        "pageCount": { "type": "integer", "minimum": 1 }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "scales"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer" },
        "scales": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scale" }
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/identifier" }
      }
    },
    "prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256", "pageCount", "totalBytes"],
      "properties": {
        "relativePath": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "pageCount": { "type": "integer", "minimum": 1 },
        "totalBytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

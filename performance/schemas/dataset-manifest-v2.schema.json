{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cabo-2/MemoriaNote/performance/schemas/dataset-manifest-v2.schema.json",
  "title": "MemoriaNote performance dataset manifest version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "datasetVersion",
    "languages",
    "source",
    "licenses",
    "selection",
    "transform",
    "prepared",
    "statistics"
  ],
  "properties": {
    "schemaVersion": { "const": "2" },
    "datasetId": { "$ref": "#/$defs/identifier" },
    "datasetVersion": { "$ref": "#/$defs/identifier" },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "source": { "$ref": "#/$defs/source" },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/license" }
    },
    "selection": { "$ref": "#/$defs/selection" },
    "transform": { "$ref": "#/$defs/transform" },
    "prepared": { "$ref": "#/$defs/prepared" },
    "statistics": { "$ref": "#/$defs/statistics" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(^|[\\\\/])\\.\\.([\\\\/]|$)).+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "url",
        "revision",
        "contentRoot",
        "sparsePaths",
        "contentSha256"
      ],
      "properties": {
        "kind": { "const": "git" },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
        "contentRoot": { "$ref": "#/$defs/relativePath" },
        "sparsePaths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "contentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "appliesTo", "licenseFile", "attribution"],
      "properties": {
        "expression": { "type": "string", "minLength": 1 },
        "appliesTo": { "type": "string", "minLength": 1 },
        "licenseFile": { "$ref": "#/$defs/relativePath" },
        "attribution": { "type": "string", "minLength": 1 }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scaleId", "pageCount"],
      "properties": {
        "scaleId": { "$ref": "#/$defs/identifier" },
        "pageCount": { "type": "integer", "minimum": 1 }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "includeGlobs", "excludedPathSegments", "scales"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "includeGlobs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "excludedPathSegments": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "scales": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scale" }
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "outputEncoding",
        "newline",
        "pageNameStrategy",
        "titleFields",
        "tagFields"
      ],
      "properties": {
        "name": { "const": "dotnet-docs-markdown" },
        "version": { "$ref": "#/$defs/identifier" },
        "outputEncoding": { "const": "utf-8-no-bom" },
        "newline": { "const": "lf" },
        "pageNameStrategy": { "const": "repository-relative-path-v1" },
        "titleFields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tagFields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sha256", "pageCount", "totalBytes"],
      "properties": {
        "relativePath": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "pageCount": { "type": "integer", "minimum": 1 },
        "totalBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMarkdownCount",
        "sourceMarkdownBytes",
        "eligiblePageCount",
        "excludedPageCount",
        "selectedPageCount",
        "selectedBodyBytes",
        "frontMatterTitleCount",
        "headingTitleCount",
        "pathTitleCount"
      ],
      "properties": {
        "sourceMarkdownCount": { "type": "integer", "minimum": 1 },
        "sourceMarkdownBytes": { "type": "integer", "minimum": 1 },
        "eligiblePageCount": { "type": "integer", "minimum": 1 },
        "excludedPageCount": { "type": "integer", "minimum": 0 },
        "selectedPageCount": { "type": "integer", "minimum": 1 },
        "selectedBodyBytes": { "type": "integer", "minimum": 1 },
        "frontMatterTitleCount": { "type": "integer", "minimum": 0 },
        "headingTitleCount": { "type": "integer", "minimum": 0 },
        "pathTitleCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

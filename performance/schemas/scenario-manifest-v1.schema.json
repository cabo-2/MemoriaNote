{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cabo-2/MemoriaNote/performance/schemas/scenario-manifest-v1.schema.json",
  "title": "MemoriaNote performance scenario manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarios"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exitCode",
        "standardOutputContains",
        "standardErrorContains",
        "standardOutputEmpty",
        "standardErrorEmpty"
      ],
      "properties": {
        "exitCode": { "type": "integer" },
        "standardOutputContains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "standardErrorContains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "standardOutputEmpty": { "type": "boolean" },
        "standardErrorEmpty": { "type": "boolean" },
        "fileSystemEntries": {
          "type": "array",
          "items": { "$ref": "#/$defs/fileSystemEntry" }
        }
      }
    },
    "fileSystemEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "exists"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["file", "directory"] },
        "exists": { "type": "boolean" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arguments", "workingDirectory", "environment"],
      "properties": {
        "arguments": {
          "type": "array",
          "items": { "type": "string" }
        },
        "standardInput": { "type": "string" },
        "workingDirectory": { "type": "string", "minLength": 1 },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "arrangeStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "expected"],
      "properties": {
        "command": { "$ref": "#/$defs/command" },
        "expected": { "$ref": "#/$defs/expected" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "scenarioVersion",
        "description",
        "availability",
        "artifactInputKind",
        "cacheMode",
        "arrange",
        "command",
        "expected",
        "warmupCount",
        "measurementCount",
        "timeoutMilliseconds",
        "resetPolicy"
      ],
      "properties": {
        "scenarioId": { "$ref": "#/$defs/identifier" },
        "scenarioVersion": { "$ref": "#/$defs/identifier" },
        "description": { "type": "string", "minLength": 1 },
        "availability": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "artifactInputKind": {
          "enum": ["publish-directory", "extracted-archive"]
        },
        "datasetId": { "$ref": "#/$defs/identifier" },
        "scaleId": { "$ref": "#/$defs/identifier" },
        "cacheMode": {
          "enum": [
            "process-cold",
            "warm-reopen",
            "fresh-state",
            "os-cold-diagnostic"
          ]
        },
        "arrange": {
          "type": "array",
          "items": { "$ref": "#/$defs/arrangeStep" }
        },
        "command": { "$ref": "#/$defs/command" },
        "expected": { "$ref": "#/$defs/expected" },
        "warmupCount": { "type": "integer", "minimum": 0 },
        "measurementCount": { "type": "integer", "minimum": 20 },
        "timeoutMilliseconds": { "type": "integer", "minimum": 1 },
        "resetPolicy": { "enum": ["per-trial", "reuse-state"] }
      }
    }
  }
}

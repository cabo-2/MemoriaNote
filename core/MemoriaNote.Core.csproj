<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>MemoriaNote.Core</PackageId>
    <IsPackable>true</IsPackable>
    <Authors>Memoria Note contributors</Authors>
    <Description>First-party Memoria Note Core application and validation integration surfaces.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>memoria-note;core;integration-contract-v3</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/cabo-2/MemoriaNote</RepositoryUrl>
    <MemoriaNoteIntegrationContractRevision>3</MemoriaNoteIntegrationContractRevision>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MemoriaNote.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence/SchemaV2/Sql/schema-v2.sql"
                      LogicalName="MemoriaNote.Persistence.SchemaV2.Sql.schema-v2.sql" />
    <EmbeddedResource Include="Persistence/SchemaV2/Sql/rebuild-page-tags.sql"
                      LogicalName="MemoriaNote.Persistence.SchemaV2.Sql.rebuild-page-tags.sql" />
    <EmbeddedResource Include="Persistence/SchemaV2/Sql/rebuild-fts-unicode61.sql"
                      LogicalName="MemoriaNote.Persistence.SchemaV2.Sql.rebuild-fts-unicode61.sql" />
    <EmbeddedResource Include="Persistence/SchemaV2/Sql/rebuild-fts-trigram.sql"
                      LogicalName="MemoriaNote.Persistence.SchemaV2.Sql.rebuild-fts-trigram.sql" />
    <EmbeddedResource Include="Persistence/SchemaV2/Contracts/schema-v2.expected.json"
                      LogicalName="MemoriaNote.Persistence.SchemaV2.Contracts.schema-v2.expected.json" />
  </ItemGroup>

  <Target
    Name="ResolveMemoriaNoteCorePackageIdentity"
    BeforeTargets="BeforeCompile;GenerateNuspec">
    <Exec
      Command="git rev-parse HEAD"
      ConsoleToMSBuild="true"
      IgnoreExitCode="true"
      StandardOutputImportance="Low"
      StandardErrorImportance="Low"
      WorkingDirectory="$(MSBuildThisFileDirectory)"
      Condition="'$(MemoriaNoteFullCommitId)' == ''">
      <Output TaskParameter="ConsoleOutput" PropertyName="MemoriaNoteFullCommitId" />
    </Exec>

    <PropertyGroup>
      <MemoriaNoteFullCommitId>$([System.String]::Copy('$(MemoriaNoteFullCommitId)').Trim().ToLowerInvariant())</MemoriaNoteFullCommitId>
      <MemoriaNoteShortPackageCommit Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(MemoriaNoteFullCommitId)', '^[0-9a-f]{40}$'))">$([System.String]::Copy('$(MemoriaNoteFullCommitId)').Substring(0, 12))</MemoriaNoteShortPackageCommit>
      <MemoriaNotePackageVersion Condition="'$(MemoriaNotePackageVersion)' == ''">$(MemoriaNoteProductVersion)-ecli1160e.g$(MemoriaNoteShortPackageCommit)</MemoriaNotePackageVersion>
      <PackageVersion>$(MemoriaNotePackageVersion)</PackageVersion>
      <RepositoryCommit>$(MemoriaNoteFullCommitId)</RepositoryCommit>
      <_MemoriaNoteIdentitySource>$(IntermediateOutputPath)MemoriaNote.Core.Identity.g.cs</_MemoriaNoteIdentitySource>
    </PropertyGroup>

    <Error
      Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(MemoriaNoteFullCommitId)', '^[0-9a-f]{40}$'))"
      Text="Core builds require a full Git commit ID. Build from a Git checkout or set MemoriaNoteFullCommitId explicitly." />
    <Error
      Condition="'$(MemoriaNotePackageVersion)' == ''"
      Text="Core builds require a unique package version." />

    <ItemGroup>
      <_MemoriaNoteIdentityLine Include="#nullable enable" />
      <_MemoriaNoteIdentityLine Include="[assembly: System.Reflection.AssemblyMetadataAttribute(&quot;MemoriaNote.PackageId&quot;, &quot;$(PackageId)&quot;)]" />
      <_MemoriaNoteIdentityLine Include="[assembly: System.Reflection.AssemblyMetadataAttribute(&quot;MemoriaNote.PackageVersion&quot;, &quot;$(MemoriaNotePackageVersion)&quot;)]" />
      <_MemoriaNoteIdentityLine Include="[assembly: System.Reflection.AssemblyMetadataAttribute(&quot;MemoriaNote.SourceCommit&quot;, &quot;$(MemoriaNoteFullCommitId)&quot;)]" />
      <_MemoriaNoteIdentityLine Include="[assembly: System.Reflection.AssemblyMetadataAttribute(&quot;MemoriaNote.IntegrationContractRevision&quot;, &quot;$(MemoriaNoteIntegrationContractRevision)&quot;)]" />
      <Compile Include="$(_MemoriaNoteIdentitySource)" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(_MemoriaNoteIdentitySource)"
      Lines="@(_MemoriaNoteIdentityLine)"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>

</Project>

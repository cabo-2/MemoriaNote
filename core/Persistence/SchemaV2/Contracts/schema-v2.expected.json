  "sqlRequirements": [
    {
      "type": "trigger",
      "name": "Pages_TagsInsert",
      "requiredFragments": [
        "AFTER INSERT ON Pages",
        "SELECT new.InternalId, value FROM json_each(new.Tags)"
      ]
    },
    {
      "type": "trigger",
      "name": "Pages_TagsUpdate",
      "requiredFragments": [
        "AFTER UPDATE OF Tags ON Pages",
        "WHEN old.Tags IS NOT new.Tags",
        "DELETE FROM PageTags WHERE PageInternalId = old.InternalId",
        "SELECT new.InternalId, value FROM json_each(new.Tags)"
      ]
    },
    {
      "type": "trigger",
      "name": "Pages_FtsUpdate",
      "requiredFragments": [
        "AFTER UPDATE OF Name, Text ON Pages",
        "WHEN old.Name IS NOT new.Name OR old.Text IS NOT new.Text"
      ]
    },
    {
      "type": "trigger",
      "name": "Pages_RejectInternalIdUpdate",
      "requiredFragments": [
        "BEFORE UPDATE OF InternalId ON Pages",
        "RAISE(ABORT, 'Pages.InternalId is immutable')"
      ]
    },
    {
      "type": "trigger",
      "name": "Pages_RejectPageIdUpdate",
      "requiredFragments": [
        "BEFORE UPDATE OF PageId ON Pages",
        "RAISE(ABORT, 'Pages.PageId is immutable')"
      ]
    }
  ]

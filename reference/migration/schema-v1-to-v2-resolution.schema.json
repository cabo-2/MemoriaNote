{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memoria Note schema v1 to v2 migration resolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "renames",
    "tagOverrides",
    "erasedPageExclusions"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "renames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pageId", "name"],
        "properties": {
          "pageId": {
            "$ref": "#/$defs/pageId"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "tagOverrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pageId", "labels"],
        "properties": {
          "pageId": {
            "$ref": "#/$defs/pageId"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "erasedPageExclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pageId"
      }
    }
  },
  "$defs": {
    "pageId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memoria-note:archive:v1:manifest",
  "title": "MemoriaNote archive v1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "archiveFormatVersion",
    "contentModelVersion",
    "sourceNotebookFormatVersion",
    "createdBy",
    "createdAtUtc",
    "dataSets"
  ],
  "properties": {
    "format": {
      "const": "memoria-note-archive"
    },
    "archiveFormatVersion": {
      "const": 1
    },
    "contentModelVersion": {
      "const": 1
    },
    "sourceNotebookFormatVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "createdBy": {
      "$ref": "#/$defs/createdBy"
    },
    "createdAtUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{7}Z$"
    },
    "dataSets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "pages"
      ],
      "properties": {
        "metadata": {
          "$ref": "#/$defs/metadataDataSet"
        },
        "pages": {
          "$ref": "#/$defs/pagesDataSet"
        }
      }
    }
  },
  "$defs": {
    "createdBy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application",
        "version"
      ],
      "properties": {
        "application": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "dataSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "recordCount",
        "uncompressedByteLength",
        "sha256"
      ],
      "properties": {
        "entry": {
          "type": "string"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0
        },
        "uncompressedByteLength": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "metadataDataSet": {
      "allOf": [
        {
          "$ref": "#/$defs/dataSet"
        },
        {
          "properties": {
            "entry": {
              "const": "metadata.json"
            },
            "recordCount": {
              "maximum": 65536
            },
            "uncompressedByteLength": {
              "maximum": 16777216
            }
          }
        }
      ]
    },
    "pagesDataSet": {
      "allOf": [
        {
          "$ref": "#/$defs/dataSet"
        },
        {
          "properties": {
            "entry": {
              "const": "pages.ndjson"
            },
            "recordCount": {
              "maximum": 1000000
            },
            "uncompressedByteLength": {
              "maximum": 8589934592
            }
          }
        }
      ]
    }
  }
}

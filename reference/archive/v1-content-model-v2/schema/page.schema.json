{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memoria-note:archive:v1:content-model:v2:page",
  "title": "MemoriaNote archive v1 content model v2 draft page record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceInternalId",
    "pageId",
    "name",
    "createTime",
    "updateTime",
    "revision",
    "tags",
    "text"
  ],
  "properties": {
    "sourceInternalId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "pageId": {
      "type": "string",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "createTime": {
      "$ref": "#/$defs/storedDateTime"
    },
    "updateTime": {
      "$ref": "#/$defs/storedDateTime"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "tags": {
      "type": "string"
    },
    "text": {
      "type": "string"
    }
  },
  "$defs": {
    "storedDateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{7}$"
    }
  }
}

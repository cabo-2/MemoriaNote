{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memoria-note:archive:v1:content-model:v2:metadata",
  "title": "MemoriaNote archive v1 content model v2 draft metadata data set",
  "$comment": "Metadata keys are additionally unique by ordinal comparison. A non-null CreateTime must be a valid Gregorian calendar date and clock value.",
  "type": "array",
  "maxItems": 65536,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "key",
      "value"
    ],
    "properties": {
      "key": {
        "type": "string",
        "maxLength": 1024,
        "not": {
          "enum": [
            "Name",
            "Version"
          ]
        }
      },
      "value": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "allOf": [
    {
      "contains": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "const": "Author"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    },
    {
      "contains": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "const": "CreateTime"
          },
          "value": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}(0[1-9]|1[0-2])([0-2][0-9]|3[01])(0[1-9]|1[0-2])[0-5][0-9][0-5][0-9]$"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    },
    {
      "contains": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "const": "Description"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    },
    {
      "contains": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "const": "ReadOnly"
          },
          "value": {
            "enum": [
              "False",
              "True"
            ]
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    },
    {
      "contains": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "const": "Tag"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    },
    {
      "contains": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "const": "Title"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    }
  ]
}

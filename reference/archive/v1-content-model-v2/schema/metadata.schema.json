{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memoria-note:archive:v1:content-model:v2:metadata",
  "title": "MemoriaNote archive v1 content model v2 draft metadata data set",
  "type": "array",
  "maxItems": 65536,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "key",
      "value"
    ],
    "properties": {
      "key": {
        "type": "string",
        "maxLength": 1024
      },
      "value": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "allOf": [
    {
      "contains": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "const": "Name"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "minContains": 1
    },
    {
      "contains": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "const": "Title"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "minContains": 1
    },
    {
      "contains": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "const": "Version"
          },
          "value": {
            "const": "2"
          }
        }
      },
      "minContains": 1
    }
  ]
}
